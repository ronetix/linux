&epxp {
	status = "okay";
};

&isi {
	/* enabled together with the camera, see &ov5640_mipi */
	status = "disabled";

	port {
		isi_in: endpoint {
			remote-endpoint = <&mipi_csi_out>;
		};
	};
};

&mipi_csi {
	/*
	 * Disabled while no camera is fitted, and not only for tidiness:
	 * dwc_csi_async_register() looks the sensor up with
	 * fwnode_graph_get_endpoint_by_id(), which skips endpoints whose
	 * remote node is unavailable. With the sensor disabled it finds
	 * none and returns -ENOTCONN, so the probe fails on every boot
	 *   dwc-mipi-csi2 4ae00000.csi: Async register failed
	 *   dwc-mipi-csi2 4ae00000.csi: probe with driver dwc-mipi-csi2
	 *       failed with error -107
	 * and, because a consumer of the media block never probes, the
	 * block controller cannot run its sync_state()
	 *   imx93-blk-ctrl 4ac10000.system-controller: sync_state() pending
	 *       due to 4ae00000.csi
	 * which leaves that block's clocks and power domain held in the
	 * state the boot left them in.
	 *
	 * The i.MX93 EVK keeps these nodes enabled because it expects a
	 * camera; on a SoM the camera is optional and usually absent.
	 */
	status = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			mipi_csi_in: endpoint {
				remote-endpoint = <&ov5640_mipi_ep>;
				data-lanes = <1 2>;
				cfg-clk-range = <28>;
				hs-clk-range = <0x16>;
			};
		};

		port@1 {
			reg = <1>;

			mipi_csi_out: endpoint {
				remote-endpoint = <&isi_in>;
			};
		};
	};
};

&dphy_rx {
	/* enabled together with the camera, see &ov5640_mipi */
	status = "disabled";
};
